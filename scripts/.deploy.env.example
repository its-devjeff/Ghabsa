# Ghabsa deploy target - operator-local. Copy to `.deploy.env` (same directory) and fill in.
# The real file is GITIGNORED. Sourced by scripts/lib/common.sh. No app secrets here - those live
# in config/ghabsa-api.env (also gitignored), rendered by local/init-config.sh.

# The VPS. Public IP or hostname.
SERVER_HOST=REPLACE_SERVER_IP

# SSH login user with PASSWORDLESS sudo (or root). Not the `ghabsa` service user (no shell).
SSH_USER=REPLACE_SSH_USER

# Private key for that user (optional if ssh-agent / ~/.ssh/config resolves it).
SSH_KEY=~/.ssh/id_ed25519

# Optional: SSH port if not 22.
# SSH_PORT=22

# Public name. www.<DOMAIN> is served too (301 to the apex once TLS is on).
DOMAIN=ghabsa.com

# Let's Encrypt account email (expiry notices) - used by local/setup-tls.sh.
LETSENCRYPT_EMAIL=you@example.com
